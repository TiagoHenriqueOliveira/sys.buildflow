# Bloqueia acesso estático direto do Apache a esta pasta. Sem isso, qualquer
# arquivo aqui seria servido diretamente (sem passar pelo Laravel), e a
# autenticação da rota GET /storage/{path} (routes/web.php) seria contornada.
# Toda leitura destes arquivos deve passar pelo StorageController.

<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order allow,deny
    Deny from all
</IfModule>
